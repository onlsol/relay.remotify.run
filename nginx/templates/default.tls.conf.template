limit_req_zone $binary_remote_addr zone=session_create:10m rate=${RATE_LIMIT};

# Access log with the session key masked out of the request line.
map $request $request_masked {
    "~^(?<pre>\S+\s\S*?)[a-f0-9]{32}(?<post>.*)$" "$pre<key>$post";
    default $request;
}
log_format masked '$remote_addr - $remote_user [$time_local] "$request_masked" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

upstream remotify_api { server api:9000; }

gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_types text/plain text/css text/javascript text/x-shellscript application/json application/javascript application/octet-stream;

# Default server: every hostname that is not this relay's vhost, including
# names that still resolve here after a move. All of it goes to the app,
# which already answers retired names with the 426 endpoint-moved payload
# ("nothing is served on this name"). The landing page and every real
# route stay on ${DOMAIN}, so the relay no longer serves its page, or
# anything else readable, under a hostname it does not own.
server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log masked;

    location / {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;
    access_log /var/log/nginx/access.log masked;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    location / {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }
}

# HTTP: ACME challenge + redirect to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log masked;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / { return 301 https://$host$request_uri; }
}

# HTTPS: all traffic
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log masked;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    root /usr/share/nginx/html;
    index index.html;

    location = /api/session {
        limit_req zone=session_create burst=${RATE_LIMIT_BURST} nodelay;
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    location ~ ^/(api|r|cmd-|result-) {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
        client_max_body_size ${MAX_BODY_SIZE};
        fastcgi_read_timeout ${PROXY_TIMEOUT}s;
    }

    location = /source {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
