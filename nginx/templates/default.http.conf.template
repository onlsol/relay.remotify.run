limit_req_zone $binary_remote_addr zone=session_create:10m rate=${RATE_LIMIT};

# Access log with the session key masked out of the request line.
map $request $request_masked {
    "~^(?<pre>\S+\s\S*?)[a-f0-9]{32}(?<post>.*)$" "$pre<key>$post";
    default $request;
}
log_format masked '$remote_addr - $remote_user [$time_local] "$request_masked" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

upstream remotify_api { server api:9000; }

gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_types text/plain text/css text/javascript text/x-shellscript application/json application/javascript application/octet-stream;

server {
    listen 80;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log masked;

    root /usr/share/nginx/html;
    index index.html;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # Rate-limited session creation
    location = /api/session {
        limit_req zone=session_create burst=${RATE_LIMIT_BURST} nodelay;
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    # All app routes -> PHP (api, runner script, queue endpoints)
    location ~ ^/(api|r|cmd-|result-) {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
        client_max_body_size ${MAX_BODY_SIZE};
        fastcgi_read_timeout ${PROXY_TIMEOUT}s;
    }

    # Source-code redirect -> PHP (reads SOURCE_URL from env and 302s)
    location = /source {
        include fastcgi_params;
        fastcgi_pass  remotify_api;
        fastcgi_param SCRIPT_FILENAME /var/www/html/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    # Static landing page + assets
    location / {
        try_files $uri $uri/ =404;
    }
}
