# Copy to .env. Defaults give a working local HTTP stack at http://localhost:49180.

# Public hostname, no port.
DOMAIN=localhost
# http | https, baked into generated URLs.
SCHEME=http
# Port in generated URLs; empty = standard port of SCHEME.
PUBLIC_PORT=49180

# http | tls (tls needs --profile tls).
NGINX_MODE=http
# Host ports; a public TLS deploy uses 80 and 443.
HTTP_PORT=49180
HTTPS_PORT=49443
# Per-IP limit on POST /api/session, nginx limit_req syntax.
RATE_LIMIT=10r/m
RATE_LIMIT_BURST=5
# Seconds; must exceed LONGPOLL_MS.
PROXY_TIMEOUT=3600
# Max push size, nginx syntax; 0 = unlimited at nginx.
MAX_BODY_SIZE=25m
# Long-poll window in ms; 0 = immediate 204.
LONGPOLL_MS=15000

# PHP workers; each live session pins about 2.
FPM_MAX_CHILDREN=64
# Requests per worker before recycle; 0 = never.
FPM_MAX_REQUESTS=500

# 1 = log key generation to stderr.
AUDIT_LOG=0
# Idle TTL in seconds, reset by every request.
SESSION_TTL=10800
# Landing page source link target; empty hides it.
SOURCE_URL=

# tls profile: ACME contact address, and 1 for the ACME staging environment.
CERTBOT_EMAIL=
CERTBOT_STAGING=0

# Local dev: DOMAIN=remotify.localtest.me resolves to 127.0.0.1 without /etc/hosts.
